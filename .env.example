# Скопіюйте цей файл у .env і заповніть один із варіантів.
# Файл .env не потрапляє в git. Без нього гра працює, але без мовної моделі.
# Підходить будь-який сервіс з OpenAI-сумісним API.

# Варіант 1. OpenAI (платно)
CHESS_LLM_BASE_URL=https://api.openai.com/v1
CHESS_LLM_API_KEY=
CHESS_LLM_MODEL=

# Варіант 2. Ollama – модель на вашому комп'ютері, безкоштовно, без інтернету
# CHESS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CHESS_LLM_API_KEY=ollama
# CHESS_LLM_MODEL=llama3.1

# Варіант 3. Groq
# CHESS_LLM_BASE_URL=https://api.groq.com/openai/v1
# CHESS_LLM_API_KEY=
# CHESS_LLM_MODEL=

# Скільки секунд чекати відповіді
CHESS_LLM_TIMEOUT=60
